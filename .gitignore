# Local dependencies and caches
node_modules/
.npm/
.cache/
__pycache__/
*.py[cod]

# Secrets and local configuration
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# Editor and operating system files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs, test output and generated deployment artifacts
*.log
coverage/
playwright-report/
test-results/
*-deploy.tar.gz
*-preview.png

# dist/ is the hand-authored static application: keep it tracked.
# tests/*.epub are small synthetic fixtures: keep them tracked.

# Supplied editions and private Library packages require redistribution approval.
*.epub
!dist/assets/alice.epub
!tests/*.epub
*library-seed*.zip
private-samples/
sample-content/*.zip
